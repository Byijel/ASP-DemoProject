@page "/edit/{Id:int}"
@rendermode InteractiveServer
@inject CityService CityService
@inject NavigationManager NavigationManager
@using Ap.Demo.Application.CQRS.City

<h3>Edit City</h3>

@if (city == null)
{
    <p>Laden...</p>
}
else
{
    <EditForm Model="@city" OnValidSubmit="Save">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label>Name:</label>
            <InputText class="form-control" @bind-Value="city.Name" disabled />
        </div>
        <div class="form-group">
            <label>Population:</label>
            <InputNumber class="form-control" @bind-Value="city.Population" />
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
        <button type="button" class="btn btn-secondary" @onclick="GoBack">Back to List</button>
    </EditForm>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success">@successMessage</div>
    }
}

@code {
    [Parameter]
    public int Id { get; set; }

    private CityDTO? city;
    private string errorMessage = "";
    private string successMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await CitiesById();
    }

    private async Task CitiesById()
    {
        city = await CityService.GetCityById(Id);
        if (city != null) city.Id = Id;
    }

    private async Task Save()
    {
        if (city == null) return;

        try
        {
            var updateDto = new UpdateCityDTO { Id = Id, Population = city.Population };
            var updatedCity = await CityService.UpdateCity(Id, updateDto);
            city.Population = updatedCity.Population;
            errorMessage = "";
            successMessage = "City updated successfully!";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error updating city: {ex.Message}";
            successMessage = "";
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/");
    }
}



@page "/cities"
@rendermode InteractiveServer
@inject CityService CityService;
@inject NavigationManager NavigationManager

<h3>Lijst van Steden</h3>

<select @onchange="SortChanged">
    <option value="asc">Oplopend (inwoners)</option>
    <option value="desc">Aflopend (inwoners)</option>
</select>

@if (cities == null)
{
    <p>Laden...</p>
}
else if (!cities.Any())
{
    <p>Geen steden gevonden.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Naam</th>
                <th>Inwoners</th>
                <th>Land</th>
                <th>Edit</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var city in cities)
            {
                <tr>
                    <td>@city.Name</td>
                    <td>@city.Population</td>
                    <td>@city.CountryName</td>
                    <td><button class="btn btn-primary" @onclick=" () => GoToEdit(city.Id)">Edit</button></td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<CityDto>? cities;

    protected override async Task OnInitializedAsync()
    {
        await LoadCities("asc");
    }

    private async Task LoadCities(string sortOrder)
    {
        cities = await CityService.GetAllCities();
    }

    private async Task SortChanged(ChangeEventArgs e)
    {
        await LoadCities(e.Value?.ToString() ?? "asc");
    }

    private void GoToEdit(int id)
    {
        Console.WriteLine($"Navigating to /cities/edit/{id}");
        NavigationManager.NavigateTo($"/cities/edit/{id}");
    }
}
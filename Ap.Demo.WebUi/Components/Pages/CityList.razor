@page "/"
@inject IHttpClientFactory HttpClientFactory
@using System.Net.Http.Json
@using Ap.Demo.Application.CQRS.City
@using Ap.Demo.Application.CQRS.Country

<div class="d-flex align-items-center justify-content-between mb-3">
	<h3 class="mb-0">Lijst van Steden</h3>
	<a class="btn btn-primary" href="/addForm">Stad toevoegen</a>
</div>

<select @onchange="SortChanged" class="form-select w-auto mb-3">
	<option value="asc">Oplopend (inwoners)</option>
	<option value="desc">Aflopend (inwoners)</option>
</select>

@if (cities == null || countries == null)
{
	<p>Laden...</p>
}
else if (!cities.Any())
{
	<p>Geen steden gevonden.</p>
}
else
{
	<table class="table">
		<thead>
			<tr>
				<th>Naam</th>
				<th>Inwoners</th>
				<th>Land</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var city in cities)
			{
				<tr>
					<td>@city.Name</td>
					<td>@city.Population</td>
					<td>@GetCountryName(city.CountryId)</td>
				</tr>
			}
		</tbody>
	</table>
}

@code {
	private IEnumerable<CityDTO>? cities;
	private List<CountryDTO>? countries;
	private Dictionary<int, string> countryNamesById = new();

	protected override async Task OnInitializedAsync()
	{
		await LoadCountries();
		await LoadCities("asc");
	}

	private async Task LoadCountries()
	{
		var client = HttpClientFactory.CreateClient("ApiClient");
		var resp = await client.GetAsync("/api/v1/countries");
		resp.EnsureSuccessStatusCode();
		var data = await resp.Content.ReadFromJsonAsync<IEnumerable<CountryDTO>>();
		countries = data?.ToList() ?? new List<CountryDTO>();
		countryNamesById = countries.ToDictionary(c => c.Id, c => c.Name);
	}

	private async Task LoadCities(string sortOrder)
	{
		var client = HttpClientFactory.CreateClient("ApiClient");
		var response = await client.GetAsync($"/api/v1/cities?sortOrder={sortOrder}");
		response.EnsureSuccessStatusCode();
		var data = await response.Content.ReadFromJsonAsync<IEnumerable<CityDTO>>();
		cities = data ?? Array.Empty<CityDTO>();
	}

	private async Task SortChanged(ChangeEventArgs e)
	{
		var selected = e?.Value?.ToString() ?? "asc";
		await LoadCities(selected);
	}

	private string GetCountryName(int countryId) =>
		countryNamesById.TryGetValue(countryId, out var name) ? name : "(onbekend)";
}